{
  "services": {
    "web-web": {
      "image": "odoo:17.0",
      "depends_on": {
        "web-mydb": {}
      },
      "ports": [
        "8069:8069"
      ],
      "environment": [
        "HOST=mydb",
        "USER=odoo",
        "PASSWORD=myodoo"
      ],
      "hostname": "web",
      "container_name": "web-web",
      "network_mode": "cosmos-web-default",
      "labels": {
        "cosmos.stack": "web",
        "cosmos.stack.main": "true"
      }
    },
    "web-mydb": {
      "image": "postgres:15",
      "environment": [
        "POSTGRES_DB=postgres",
        "POSTGRES_PASSWORD=myodoo",
        "POSTGRES_USER=odoo"
      ],
      "hostname": "mydb",
      "container_name": "web-mydb",
      "network_mode": "cosmos-web-default",
      "labels": {
        "cosmos.stack": "web"
      }
    }
  },
  "networks": {
    "cosmos-web-default": {}
  }
}
