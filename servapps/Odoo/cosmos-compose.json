{
  "cosmos-installer": {},
  "services": {
    "{ServiceName}": {
      "image": "odoo:17.0",
      "container_name": "{ServiceName}",
      "environment": [
        "PASSWORD={Passwords.0}",
        "HOST={ServiceName}-db",
        "USER={ServiceName}"
      ]
      "volumes": [
        {
          "source": "./config",
          "target": "/etc/odoo",
          "type": "bind"
        },
        {
          "source": "./addons",
          "target": "/mnt/extra-addons",
          "type": "bind"
        }
      ],
    },

    "{ServiceName}-db": {
      "image": "postgres:15",
      "container_name": "{ServiceName}-db",
      "hostname": "{ServiceName}-db",
      "environment": [
        "POSTGRES_DB={ServiceName}",
        "POSTGRES_PASSWORD={Passwords.0}",
        "POSTGRES_USER={ServiceName}",
      ]
    }
  }
}
