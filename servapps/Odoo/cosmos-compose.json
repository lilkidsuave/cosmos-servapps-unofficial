{
  "cosmos-installer": {},
  "services": {
    "{ServiceName}": {
      "image": "odoo:17.0",
      "depends_on": [
        "{ServiceName}-db"
      ],
      "volumes": [
        {
          "source": "odoo-web-data",
          "target": "/var/lib/odoo",
          "type": "volume"
        },
        {
          "source": "./config",
          "target": "/etc/odoo",
          "type": "bind"
        },
        {
          "source": "./addons",
          "target": "/mnt/extra-addons",
          "type": "bind"
        }
      ],
      "environment": [
        "PASSWORD={Passwords.0}",
        "HOST=db",
        "USER=odoo"
      ]
    },

    "{ServiceName}-db": {
      "image": "postgres:15",
      "environment": [
        "POSTGRES_DB=postgres",
        "POSTGRES_PASSWORD={Passwords.0}",
        "POSTGRES_USER=odoo",
        "PGDATA=/var/lib/postgresql/data/pgdata"
      ],
      "volumes": [
        {
          "source": "odoo-db-data",
          "target": "/var/lib/postgresql/data/pgdata",
          "type": "volume"
        }
      ]
    }
  }
}
